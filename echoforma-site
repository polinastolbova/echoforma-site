<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>EchoForma — Generative Soundscapes</title>

<meta name="description"
content="EchoForma develops generative soundscapes for museums, exhibitions and architectural spaces.">

<style>

:root{

  --bg:#f5f1eb;
  --card:rgba(255,255,255,.45);

  --text:#414b54;
  --muted:#7f868b;

  --sea:#a8c4c1;
  --sand:#e4aa92;

  --line:#e2dad2;
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{

  font-family:
  system-ui,
  -apple-system,
  BlinkMacSystemFont,
  "Segoe UI",
  sans-serif;

  background:

    radial-gradient(
      circle at 82% 12%,
      rgba(168,196,193,.12),
      transparent 32%
    ),

    radial-gradient(
      circle at 18% 88%,
      rgba(228,170,146,.08),
      transparent 28%
    ),

    #f5f1eb;

  color:var(--text);

  line-height:1.65;
  overflow-x:hidden;
}

/* background waves */

.background-waves{

  position:fixed;
  inset:0;

  z-index:-1;

  pointer-events:none;

  opacity:.18;
}

.background-waves svg{

  width:100%;
  height:100%;
}

/* layout */

.container{

  width:min(1040px,92%);
  margin:auto;
}

/* header */

header{

  position:sticky;
  top:0;

  backdrop-filter:blur(14px);

  background:rgba(245,241,235,.88);

  border-bottom:1px solid var(--line);

  z-index:20;
}

.header-inner{

  display:flex;
  justify-content:space-between;
  align-items:center;

  padding:18px 0;
}

.logo{

  display:flex;
  align-items:center;
  gap:14px;
}

.logo svg{

  width:52px;
  height:auto;
}

.logo-text{

  font-size:2rem;
  font-weight:500;
}

nav{

  display:flex;
  gap:28px;
}

nav a{

  color:var(--muted);
  text-decoration:none;
  transition:.2s;
}

nav a:hover{

  color:var(--text);
}

/* hero */

.hero{

  padding:85px 0 60px;
}

.hero h1{

  font-size:clamp(2.8rem,7vw,4.3rem);

  line-height:1.05;

  font-weight:500;

  max-width:760px;

  margin-bottom:24px;
}

.hero p{

  max-width:760px;

  color:var(--muted);

  font-size:1.15rem;
}

/* sections */

section{

  padding:50px 0;
}

.section-title{

  font-size:.76rem;

  color:var(--muted);

  letter-spacing:3px;

  text-transform:uppercase;

  margin-bottom:14px;
}

.section-heading{

  font-size:2rem;

  margin-bottom:28px;

  font-weight:500;
}

/* projects */

.projects-grid{

  display:grid;

  grid-template-columns:
  repeat(auto-fit,minmax(230px,1fr));

  gap:18px;
}

.project-card{

  display:block;

  text-decoration:none;

  color:var(--text);

  background:var(--card);

  border:1px solid var(--line);

  border-radius:30px;

  padding:28px;

  min-height:230px;

  backdrop-filter:blur(10px);

  transition:.25s ease;
}

.project-card:hover{

  transform:translateY(-5px);

  border-color:var(--sea);

  background:white;

  box-shadow:
  0 18px 40px rgba(0,0,0,.05);
}

.project-card h3{

  margin-bottom:18px;

  font-size:1.35rem;

  font-weight:600;
}

.project-card p{

  color:var(--muted);
}

/* services */

.services{

  display:grid;

  grid-template-columns:
  repeat(auto-fit,minmax(220px,1fr));

  gap:14px;
}

.service{

  background:var(--card);

  border:1px solid var(--line);

  border-radius:24px;

  padding:22px;

  backdrop-filter:blur(10px);
}

.service h3{

  margin-bottom:10px;

  font-size:1rem;
}

.service p{

  color:var(--muted);
}

/* contact */

.contact{

  background:var(--card);

  border:1px solid var(--line);

  border-radius:28px;

  padding:28px;

  backdrop-filter:blur(10px);
}

.contact p{

  color:var(--muted);
}

.contact-items{

  display:flex;

  flex-wrap:wrap;

  gap:10px;

  margin-top:18px;
}

.contact-item{

  border:1px solid var(--line);

  border-radius:999px;

  padding:10px 16px;

  color:var(--muted);
}

.contact-item a{

  text-decoration:none;
}

/* footer */

footer{

  padding:45px 0;

  text-align:center;

  color:var(--muted);

  font-size:.92rem;
}

@media(max-width:760px){

  nav{
    display:none;
  }

  .logo-text{
    font-size:1.6rem;
  }

  .hero{
    padding-top:60px;
  }
}

</style>
</head>

